---
import { strings } from "../site.ts";

const t = strings.en.converter;
const r = t.results;
const fileIcon = "M6 2h8l6 6v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm7 1.5V9h5.5L13 3.5Z";
---

<section class="converter" aria-labelledby="converter-heading">
  <h2 id="converter-heading" class="visually-hidden">
    {t.heading}
  </h2>

  <div id="panel" class="panel" data-state="idle">
    <!-- 1. Choose a file -->
    <div id="state-idle" class="panel-state">
      <div class="flow-art" aria-hidden="true">
        <span class="art-wallet"></span>
        <svg class="art-arrow" viewBox="0 0 24 24" width="22" height="22">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 12h14m-5-5 5 5-5 5"
          ></path>
        </svg>
        <span class="art-sheet"></span>
      </div>
      <input
        id="pdf-file"
        class="visually-hidden"
        type="file"
        accept="application/pdf,.pdf"
        tabindex="-1"
        aria-hidden="true"
      />
      <button type="button" id="choose-btn" class="btn-big">
        {t.chooseFile}
      </button>
      <p class="panel-hint">{t.orDrag}</p>
      <p class="panel-privacy">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15">
          <path
            fill="currentColor"
            d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5Zm-3 8V7a3 3 0 0 1 6 0v3H9Z"
          ></path>
        </svg>
        {t.privacyNote}
      </p>
    </div>

    <!-- 2. Password (only when the PDF asks for one) -->
    <form id="state-password" class="panel-state panel-form" novalidate hidden>
      <p class="file-chip">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15">
          <path fill="currentColor" d={fileIcon}></path>
        </svg>
        <span class="file-name"></span>
      </p>
      <p id="password-prompt" class="panel-prompt">
        {t.passwordPrompt}
      </p>
      <label for="pdf-password" class="visually-hidden">
        {t.password}
      </label>
      <div class="password-field">
        <input
          id="pdf-password"
          type="password"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder={t.password}
          aria-describedby="password-prompt password-hint"
        />
        <button
          type="button"
          id="toggle-password"
          class="password-toggle"
          aria-controls="pdf-password"
          aria-pressed="false"
        >
          {t.showPassword}
        </button>
      </div>
      <p id="password-hint" class="hint">
        {t.passwordHint}
      </p>
      <button type="submit" class="btn-primary btn-wide">
        {t.unlock}
      </button>
      <button type="button" class="btn-link" data-action="reset">
        {t.chooseDifferent}
      </button>
    </form>

    <!-- 3. Working -->
    <div id="state-working" class="panel-state" hidden>
      <span class="spinner" aria-hidden="true"></span>
      <p>{t.converting}</p>
    </div>

    <!-- 4. Done -->
    <div id="state-done" class="panel-state" hidden>
      <span class="done-check" aria-hidden="true">
        ✓
      </span>
      <p class="done-title" id="done-title" tabindex="-1">
        {t.converted}
      </p>
      <p id="done-summary" class="panel-hint"></p>
      <p class="file-chip">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15">
          <path fill="currentColor" d={fileIcon}></path>
        </svg>
        <span class="file-name"></span>
      </p>
      <div class="downloads">
        <button type="button" id="download-xlsx" class="btn-primary">
          {r.downloadXlsx} <span class="file-tag">XLSX</span>
        </button>
        <button type="button" id="download-csv" class="btn-secondary">
          {r.downloadCsv} <span class="file-tag">CSV</span>
        </button>
      </div>
      <p class="hint">{r.sheetsTip}</p>
      <button type="button" id="reset" class="btn-link" data-action="reset">
        {r.convertAnother}
      </button>
    </div>

    <p id="error" class="error" role="alert"></p>
    <p id="status" class="visually-hidden" role="status" aria-live="polite"></p>
  </div>

  <div id="results" class="results" hidden>
    <div class="results-head">
      <h2 id="results-heading">{r.heading}</h2>
      <p id="results-period" class="muted tabular"></p>
    </div>

    <!-- Overview -->
    <div class="overview">
      <div class="ov-card ov-main">
        <p class="ov-label">{r.overview.net}</p>
        <p id="ov-net" class="ov-net tabular"></p>
        <div class="ov-balances">
          <div>
            <span class="ov-label">{r.overview.opening}</span>
            <span id="ov-opening" class="ov-value tabular"></span>
          </div>
          <svg class="ov-arrow" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 12h14m-5-5 5 5-5 5"
            ></path>
          </svg>
          <div>
            <span class="ov-label">{r.overview.closing}</span>
            <span id="ov-closing" class="ov-value tabular"></span>
          </div>
        </div>
      </div>
      <div class="ov-card ov-flows">
        <div class="flow">
          <div class="flow-top">
            <span class="ov-label">{r.overview.moneyIn}</span>
            <span id="ov-in" class="flow-amount is-in tabular"></span>
          </div>
          <div class="bar">
            <span id="bar-in" class="bar-fill is-in"></span>
          </div>
          <p id="ov-in-count" class="flow-count"></p>
        </div>
        <div class="flow">
          <div class="flow-top">
            <span class="ov-label">{r.overview.moneyOut}</span>
            <span id="ov-out" class="flow-amount tabular"></span>
          </div>
          <div class="bar">
            <span id="bar-out" class="bar-fill"></span>
          </div>
          <p id="ov-out-count" class="flow-count"></p>
        </div>
      </div>
    </div>

    <!-- Cross-check -->
    <section class="block" aria-labelledby="verify-heading">
      <div class="block-head">
        <h3 id="verify-heading">{r.verify.heading}</h3>
        <p>{r.verify.intro}</p>
      </div>
      <div class="table-wrap">
        <table class="verify-table">
          <thead>
            <tr>
              <th scope="col">{r.verify.check}</th>
              <th scope="col" class="num">
                {r.verify.onStatement}
              </th>
              <th scope="col" class="num">
                {r.verify.calculated}
              </th>
              <th scope="col">{r.verify.result}</th>
            </tr>
          </thead>
          <tbody id="verify-body"></tbody>
        </table>
      </div>
    </section>

    <!-- Rows to review -->
    <div id="review" class="review" role="note" hidden>
      <div class="review-text">
        <p id="review-title" class="review-title"></p>
        <p id="review-body"></p>
        <ul id="review-notes"></ul>
      </div>
      <button type="button" id="review-show" class="btn-secondary">
        {r.review.show}
      </button>
    </div>

    <!-- By month -->
    <section id="months" class="block" aria-labelledby="months-heading" hidden>
      <div class="block-head">
        <h3 id="months-heading">{r.months.heading}</h3>
      </div>
      <div class="table-wrap">
        <table class="months-table">
          <thead>
            <tr>
              <th scope="col">{r.months.month}</th>
              <th scope="col" class="num">
                {r.months.moneyIn}
              </th>
              <th scope="col" class="num">
                {r.months.moneyOut}
              </th>
              <th scope="col" class="num">
                {r.months.net}
              </th>
              <th scope="col" class="num">
                {r.months.count}
              </th>
              <th scope="col">
                <span class="visually-hidden">{r.months.view}</span>
              </th>
            </tr>
          </thead>
          <tbody id="months-body"></tbody>
        </table>
      </div>
    </section>

    <!-- Transactions -->
    <section class="block" aria-labelledby="tx-heading">
      <div class="block-head">
        <h3 id="tx-heading" tabindex="-1">
          {r.table.heading}
        </h3>
      </div>
      <div class="tx-toolbar">
        <div class="segmented" role="group" aria-label={r.table.filterLabel}>
          {(["all", "in", "out", "review"] as const).map((f) => (
            <button type="button" data-filter={f} aria-pressed={f === "all" ? "true" : "false"}>
              {r.table.filters[f]} <span class="seg-count" data-count={f} />
            </button>
          ))}
        </div>
        <div class="tx-controls">
          <label for="month-filter" class="visually-hidden">
            {r.table.month}
          </label>
          <select id="month-filter">
            <option value="">{r.table.allMonths}</option>
          </select>
          <label for="tx-search" class="visually-hidden">
            {r.table.search}
          </label>
          <input
            id="tx-search"
            type="search"
            autocomplete="off"
            placeholder={r.table.searchPlaceholder}
          />
        </div>
      </div>
      <div class="table-wrap">
        <table class="tx-table">
          <thead>
            <tr>
              <th scope="col" class="col-row">
                {r.table.columns.row}
              </th>
              <th scope="col">{r.table.columns.date}</th>
              <th scope="col">{r.table.columns.description}</th>
              <th scope="col" class="num">
                {r.table.columns.amount}
              </th>
              <th scope="col" class="num">
                {r.table.columns.balance}
              </th>
              <th scope="col">{r.table.columns.status}</th>
            </tr>
          </thead>
          <tbody id="tx-body"></tbody>
        </table>
        <p id="tx-empty" class="tx-empty" hidden>
          {r.table.empty}
        </p>
      </div>
      <nav class="pager" aria-label="Pagination">
        <p id="tx-range" class="muted tabular" aria-live="polite"></p>
        <div id="pager-buttons" class="pager-buttons"></div>
      </nav>
    </section>
  </div>
</section>

<script>
  import "../scripts/converter.ts";
</script>
