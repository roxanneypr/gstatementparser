---
import { strings } from "../site.ts";

/** The balance is left out for statements that don't print one (e.g. BDO Account Activities). */
export type ExampleRow = [date: string, description: string, amount: string, balance?: string];

export interface Props {
  /** "Example output" rows in the wallet's real statement wording, with fake amounts. */
  exampleRows?: ExampleRow[];
  /** FAKE statement that "Try a sample statement" converts (same-origin, under /sample/). */
  sampleUrl?: string;
  /** Ticks under the example; only claim checks the statement makes possible. */
  exampleChecks?: string[];
}

const t = strings.en.converter;
const r = t.results;
const ex = t.example;
// Statement-style wording (as GCash prints it), fake amounts; balances add up.
const gcashExample: ExampleRow[] = [
  ["Mar 1", "Received GCash from BPI with account ending in 1234", "+₱5,000.00", "₱6,250.00"],
  ["Mar 1", "Payment to Angkas", "−₱186.00", "₱6,064.00"],
  ["Mar 2", "Transfer from 09170000001 to 09180000002", "−₱1,500.00", "₱4,564.00"],
  ["Mar 4", "Refund from Grab Philippines", "+₱75.00", "₱4,639.00"],
];
const {
  exampleRows = gcashExample,
  sampleUrl = "/sample/sample-gcash-statement.pdf",
  exampleChecks = [ex.totals, ex.balances],
} = Astro.props;
const showBalance = exampleRows.some((row) => row[3] !== undefined);
const fileIcon = "M6 2h8l6 6v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm7 1.5V9h5.5L13 3.5Z";
---

<section id="convert" class="converter" aria-labelledby="converter-heading">
  <h2 id="converter-heading" class="visually-hidden">
    {t.heading}
  </h2>

  <div id="panel" class="panel" data-state="idle">
    <!-- 1. Choose a file -->
    <div id="state-idle" class="panel-state">
      <input
        id="pdf-file"
        class="visually-hidden"
        type="file"
        accept="application/pdf,.pdf"
        tabindex="-1"
        aria-hidden="true"
      />
      <div class="flow-art" aria-hidden="true">
        <span class="art-wallet"></span>
        <svg class="art-arrow" viewBox="0 0 24 24" width="22" height="22">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 12h14m-5-5 5 5-5 5"
          ></path>
        </svg>
        <span class="art-sheet"></span>
      </div>
      <button type="button" id="choose-btn" class="btn-big">
        {t.chooseFile}
      </button>
      <p class="panel-hint drag-hint">{t.orDrag}</p>
      <p class="panel-privacy">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15">
          <path
            fill="currentColor"
            d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5Zm-3 8V7a3 3 0 0 1 6 0v3H9Z"
          ></path>
        </svg>
        {t.privacyNote}
      </p>

      <!-- What you get: a few rows of real-looking output (sample data, statement wording). -->
      <figure class="example">
        <figcaption>
          <span>{ex.caption}</span>
          <span class="example-tag">{ex.sample}</span>
        </figcaption>
        <table>
          <thead>
            <tr>
              <th scope="col">{ex.date}</th>
              <th scope="col">{ex.description}</th>
              <th scope="col" class="num">
                {ex.amount}
              </th>
              {showBalance && (
                <th scope="col" class="num example-balance">
                  {ex.balance}
                </th>
              )}
            </tr>
          </thead>
          <tbody>
            {exampleRows.map(([date, desc, amount, balance]) => (
              <tr>
                <td class="tabular">{date}</td>
                <td class="example-desc">{desc}</td>
                <td class:list={["num", { "is-in": amount.startsWith("+") }]}>{amount}</td>
                {showBalance && <td class="num example-balance">{balance}</td>}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="example-checks">
          {exampleChecks.map((check) => (
            <span>
              <span class="tick" aria-hidden="true">
                ✓
              </span>
              {check}
            </span>
          ))}
        </p>
      </figure>

      <p class="sample-line">
        {t.noPdf}
        <button type="button" id="sample-btn" class="btn-link" data-sample-url={sampleUrl}>
          {t.trySample}
        </button>
      </p>
    </div>

    <!-- 2. Password (only when the PDF asks for one) -->
    <form id="state-password" class="panel-state panel-form" novalidate hidden>
      <p class="file-chip">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15">
          <path fill="currentColor" d={fileIcon}></path>
        </svg>
        <span class="file-name"></span>
      </p>
      <p id="password-prompt" class="panel-prompt">
        {t.passwordPrompt}
      </p>
      <label for="pdf-password" class="visually-hidden">
        {t.password}
      </label>
      <div class="password-field">
        <input
          id="pdf-password"
          type="password"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder={t.password}
          aria-describedby="password-prompt password-hint"
        />
        <button
          type="button"
          id="toggle-password"
          class="password-toggle"
          aria-controls="pdf-password"
          aria-pressed="false"
        >
          {t.showPassword}
        </button>
      </div>
      <p id="password-hint" class="hint">
        {t.passwordHint}
      </p>
      <button type="submit" class="btn-primary btn-wide">
        {t.unlock}
      </button>
      <button type="button" class="btn-link" data-action="reset">
        {t.chooseDifferent}
      </button>
    </form>

    <!-- 3. Working -->
    <div id="state-working" class="panel-state" hidden>
      <span class="spinner" aria-hidden="true"></span>
      <p>{t.converting}</p>
    </div>

    <!-- 4. Done -->
    <div id="state-done" class="panel-state done" hidden>
      <div class="done-head">
        <span class="done-check" aria-hidden="true">
          ✓
        </span>
        <div class="done-heading">
          <p class="done-title" id="done-title" tabindex="-1">
            {t.converted}
          </p>
          <p id="done-summary" class="done-sub"></p>
        </div>
        <button type="button" id="reset" class="btn-secondary btn-small" data-action="reset">
          {r.convertAnother}
        </button>
      </div>

      <div class="done-downloads">
        <button type="button" id="download-xlsx" class="btn-primary">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 4v11m-5-5 5 5 5-5M5 20h14"
            ></path>
          </svg>
          {r.downloadXlsx} <span class="ext">.xlsx</span>
        </button>
        <button type="button" id="download-csv" class="btn-secondary">
          {r.downloadCsv}
        </button>
      </div>

      <p id="done-status" class="done-status">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3 5 6v5c0 4.4 3 8.4 7 9.5 4-1.1 7-5.1 7-9.5V6l-7-3Zm-2.5 9 2 2 4-4"
          ></path>
        </svg>
        <span id="done-status-text"></span>
      </p>

      <div class="done-foot">
        <button type="button" id="view-transactions" class="view-all">
          <span id="view-all-text"></span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m6 9 6 6 6-6"
            ></path>
          </svg>
        </button>
        <p class="done-privacy">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14">
            <path
              fill="currentColor"
              d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5Zm-3 8V7a3 3 0 0 1 6 0v3H9Z"
            ></path>
          </svg>
          {r.privacyDone}
        </p>
      </div>
    </div>

    <p id="error" class="error" role="alert"></p>
    <p id="status" class="visually-hidden" role="status" aria-live="polite"></p>
  </div>

  <div id="results" class="results" hidden>
    <div class="results-head">
      <h2 id="results-heading">{r.heading}</h2>
      <p id="results-period" class="muted tabular"></p>
    </div>

    <!-- Overview -->
    <div class="overview">
      <div class="ov-card ov-main">
        <p class="ov-label">{r.overview.net}</p>
        <p id="ov-net" class="ov-net tabular"></p>
        <div class="ov-balances">
          <div>
            <span class="ov-label">{r.overview.opening}</span>
            <span id="ov-opening" class="ov-value tabular"></span>
          </div>
          <svg class="ov-arrow" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 12h14m-5-5 5 5-5 5"
            ></path>
          </svg>
          <div>
            <span class="ov-label">{r.overview.closing}</span>
            <span id="ov-closing" class="ov-value tabular"></span>
          </div>
        </div>
      </div>
      <div class="ov-card ov-flows">
        <div class="flow">
          <div class="flow-top">
            <span class="ov-label">{r.overview.moneyIn}</span>
            <span id="ov-in" class="flow-amount is-in tabular"></span>
          </div>
          <div class="bar">
            <span id="bar-in" class="bar-fill is-in"></span>
          </div>
          <p id="ov-in-count" class="flow-count"></p>
        </div>
        <div class="flow">
          <div class="flow-top">
            <span class="ov-label">{r.overview.moneyOut}</span>
            <span id="ov-out" class="flow-amount tabular"></span>
          </div>
          <div class="bar">
            <span id="bar-out" class="bar-fill"></span>
          </div>
          <p id="ov-out-count" class="flow-count"></p>
        </div>
      </div>
    </div>

    <!-- Rows to review -->
    <div id="review" class="review" role="note" hidden>
      <p class="review-line">
        <svg class="review-icon" aria-hidden="true" viewBox="0 0 24 24" width="15" height="15">
          <path
            d="M12 3.5 2.5 20h19L12 3.5Zm0 6v5m0 2.6v.1"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        <span id="review-title" class="review-title"></span>
        <span id="review-body"></span>
        <button type="button" id="review-show" class="btn-link">
          {r.review.show}
        </button>
      </p>
      <ul id="review-notes"></ul>
    </div>

    <!-- By month -->
    <section id="months" class="block" aria-labelledby="months-heading" hidden>
      <div class="block-head">
        <h3 id="months-heading">{r.months.heading}</h3>
      </div>
      <div class="table-wrap">
        <table class="months-table">
          <thead>
            <tr>
              <th scope="col">{r.months.month}</th>
              <th scope="col" class="num">
                {r.months.moneyIn}
              </th>
              <th scope="col" class="num">
                {r.months.moneyOut}
              </th>
              <th scope="col" class="num">
                {r.months.net}
              </th>
              <th scope="col" class="num">
                {r.months.count}
              </th>
              <th scope="col">
                <span class="visually-hidden">{r.months.view}</span>
              </th>
            </tr>
          </thead>
          <tbody id="months-body"></tbody>
        </table>
      </div>
    </section>

    <!-- By category -->
    <section id="categories" class="block" aria-labelledby="categories-heading" hidden>
      <div class="block-head">
        <h3 id="categories-heading">{r.categories.heading}</h3>
        <p>{r.categories.note}</p>
      </div>
      <div class="table-wrap">
        <table class="months-table cat-table">
          <thead>
            <tr>
              <th scope="col">{r.categories.category}</th>
              <th scope="col" class="num">
                {r.categories.moneyOut}
              </th>
              <th scope="col" class="num">
                {r.categories.moneyIn}
              </th>
              <th scope="col" class="num">
                {r.categories.count}
              </th>
              <th scope="col">
                <span class="visually-hidden">{r.categories.view}</span>
              </th>
            </tr>
          </thead>
          <tbody id="categories-body"></tbody>
        </table>
      </div>
    </section>

    <!-- Transactions -->
    <section class="block" aria-labelledby="tx-heading">
      <div class="block-head">
        <h3 id="tx-heading" tabindex="-1">
          {r.table.heading}
        </h3>
        <div id="cleanup" class="cleanup" hidden>
          <label class="cleanup-check">
            <input type="checkbox" id="cleanup-toggle" />
            <span>{r.cleanup.label}</span>
          </label>
          <button
            type="button"
            id="cleanup-info-btn"
            class="info-btn"
            aria-label={r.cleanup.infoLabel}
            aria-expanded="false"
            aria-controls="cleanup-info"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
              <circle
                cx="12"
                cy="12"
                r="9"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
              ></circle>
              <path
                d="M12 11v5M12 8h.01"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              ></path>
            </svg>
          </button>
          <p id="cleanup-info" class="info-tip" role="tooltip" hidden>
            {r.cleanup.info}
          </p>
        </div>
      </div>
      <div class="tx-toolbar">
        <div class="segmented" role="group" aria-label={r.table.filterLabel}>
          {(["all", "in", "out", "review"] as const).map((f) => (
            <button type="button" data-filter={f} aria-pressed={f === "all" ? "true" : "false"}>
              {r.table.filters[f]} <span class="seg-count" data-count={f} />
            </button>
          ))}
        </div>
        <div class="tx-controls">
          <label for="month-filter" class="visually-hidden">
            {r.table.month}
          </label>
          <select id="month-filter">
            <option value="">{r.table.allMonths}</option>
          </select>
          <label for="category-filter" class="visually-hidden">
            {r.table.category}
          </label>
          <select id="category-filter">
            <option value="">{r.table.allCategories}</option>
          </select>
          <label for="tx-search" class="visually-hidden">
            {r.table.search}
          </label>
          <input
            id="tx-search"
            type="search"
            autocomplete="off"
            placeholder={r.table.searchPlaceholder}
          />
        </div>
      </div>
      <div class="table-wrap">
        <table class="tx-table">
          <thead>
            <tr>
              <th scope="col" class="col-row">
                {r.table.columns.row}
              </th>
              <th scope="col" class="col-date">
                {r.table.columns.date}
              </th>
              <th scope="col" class="col-desc">
                {r.table.columns.description}
              </th>
              <th scope="col" class="col-cat">
                {r.table.columns.category}
              </th>
              <th scope="col" class="num col-amount">
                {r.table.columns.amount}
              </th>
              <th scope="col" class="num col-balance">
                {r.table.columns.balance}
              </th>
            </tr>
          </thead>
          <tbody id="tx-body"></tbody>
        </table>
        <p id="tx-empty" class="tx-empty" hidden>
          {r.table.empty}
        </p>
      </div>
      <nav class="pager" aria-label="Pagination">
        <p id="tx-range" class="muted tabular" aria-live="polite"></p>
        <div id="pager-buttons" class="pager-buttons"></div>
      </nav>
    </section>
  </div>
</section>

<script>
  import "../scripts/converter.ts";
</script>
