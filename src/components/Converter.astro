---
import { strings } from "../site.ts";

const t = strings.en.converter;
const r = t.results;
---

<section class="converter" aria-labelledby="converter-heading">
  <h2 id="converter-heading" class="visually-hidden">
    {t.heading}
  </h2>

  <div id="panel" class="panel" data-state="idle">
    <!-- 1. Choose a file -->
    <div id="state-idle" class="panel-state">
      <input
        id="pdf-file"
        class="visually-hidden"
        type="file"
        accept="application/pdf,.pdf"
        tabindex="-1"
        aria-hidden="true"
      />
      <button type="button" id="choose-btn" class="btn-big">
        {t.chooseFile}
      </button>
      <p class="panel-hint">{t.orDrag}</p>
      <p class="panel-privacy">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
          <path
            fill="currentColor"
            d="M12 1 3 5v6c0 5.6 3.8 10.7 9 12 5.2-1.3 9-6.4 9-12V5l-9-4Zm-1.4 15.4-3.5-3.5 1.4-1.4 2.1 2.1 5.3-5.3 1.4 1.4-6.7 6.7Z"
          ></path>
        </svg>
        {t.privacyNote}
      </p>
    </div>

    <!-- 2. Password (only when the PDF asks for one) -->
    <form id="state-password" class="panel-state panel-form" novalidate hidden>
      <p class="file-chip">
        <span aria-hidden="true">📄</span> <span class="file-name"></span>
      </p>
      <p id="password-prompt" class="panel-prompt">
        {t.passwordPrompt}
      </p>
      <label for="pdf-password" class="visually-hidden">
        {t.password}
      </label>
      <div class="password-row">
        <input
          id="pdf-password"
          type="password"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder={t.password}
          aria-describedby="password-prompt password-hint"
        />
        <button
          type="button"
          id="toggle-password"
          class="btn-secondary"
          aria-controls="pdf-password"
          aria-pressed="false"
        >
          {t.showPassword}
        </button>
      </div>
      <p id="password-hint" class="hint">
        {t.passwordHint}
      </p>
      <button type="submit" class="btn-primary btn-wide">
        {t.unlock}
      </button>
      <button type="button" class="btn-link" data-action="reset">
        {t.chooseDifferent}
      </button>
    </form>

    <!-- 3. Working -->
    <div id="state-working" class="panel-state" hidden>
      <span class="spinner" aria-hidden="true"></span>
      <p>{t.converting}</p>
    </div>

    <!-- 4. Done -->
    <div id="state-done" class="panel-state" hidden>
      <p class="done-title" id="done-title" tabindex="-1">
        <span class="done-check" aria-hidden="true">
          ✓
        </span>
        {t.converted} <span class="file-name"></span>
      </p>
      <p id="done-summary" class="panel-hint"></p>
      <div class="downloads">
        <button type="button" id="download-xlsx" class="btn-primary">
          {r.downloadXlsx}
        </button>
        <button type="button" id="download-csv" class="btn-secondary">
          {r.downloadCsv}
        </button>
      </div>
      <p class="hint">{r.sheetsTip}</p>
      <button type="button" id="reset" class="btn-link" data-action="reset">
        {r.convertAnother}
      </button>
    </div>

    <p id="error" class="error" role="alert"></p>
    <p id="status" class="visually-hidden" role="status" aria-live="polite"></p>
  </div>

  <div id="results" class="results" hidden>
    <h2 id="results-heading">{r.detailsHeading}</h2>
    <p id="results-period" class="muted"></p>

    <dl class="stats">
      <div>
        <dt>{r.count}</dt>
        <dd id="stat-count"></dd>
      </div>
      <div>
        <dt>{r.moneyIn}</dt>
        <dd id="stat-in"></dd>
      </div>
      <div>
        <dt>{r.moneyOut}</dt>
        <dd id="stat-out"></dd>
      </div>
      <div>
        <dt>{r.net}</dt>
        <dd id="stat-net"></dd>
      </div>
    </dl>

    <h3>{r.checksHeading}</h3>
    <ul id="checks" class="checks"></ul>

    <section id="warnings" class="warnings" aria-labelledby="warnings-heading" hidden>
      <h3 id="warnings-heading">{r.warningsHeading}</h3>
      <div id="warnings-body"></div>
    </section>

    <h3>{r.previewHeading}</h3>
    <p id="preview-note" class="muted"></p>
    <div class="table-wrap">
      <table class="preview">
        <thead>
          <tr>
            <th scope="col">{r.columns.row}</th>
            <th scope="col">{r.columns.date}</th>
            <th scope="col">{r.columns.description}</th>
            <th scope="col" class="num">
              {r.columns.debit}
            </th>
            <th scope="col" class="num">
              {r.columns.credit}
            </th>
            <th scope="col" class="num">
              {r.columns.balance}
            </th>
            <th scope="col">{r.columns.check}</th>
          </tr>
        </thead>
        <tbody id="preview-body"></tbody>
      </table>
    </div>
  </div>
</section>

<script>
  import "../scripts/converter.ts";
</script>
