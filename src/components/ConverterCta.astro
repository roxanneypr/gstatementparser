---
export interface Props {
  heading?: string;
}
const { heading = "Convert your GCash statement to Excel" } = Astro.props;
---

<aside class="cta" aria-label="Converter">
  <p class="cta-heading">{heading}</p>
  <p>Free and private: your PDF is processed on your device and never uploaded.</p>
  <a class="btn-primary cta-link" href="/">
    Open the GCash statement converter
  </a>
</aside>
