---
import ConverterCta from "../components/ConverterCta.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_EMAIL, SITE_NAME } from "../site.ts";

const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: `About ${SITE_NAME}`,
  url: new URL("/about", Astro.site).href,
};
---

<BaseLayout
  title={`About – ${SITE_NAME}`}
  description="Why we built a free, private GCash statement to Excel converter for freelancers, online sellers, bookkeepers and anyone tracking their money."
  schema={schema}
>
  <div class="prose">
    <h1>About {SITE_NAME}</h1>
    <p class="lead">
      WalletToExcel is a free tool that turns your GCash Transaction History PDF into a clean Excel
      or CSV file, without your statement ever leaving your device.
    </p>

    <h2>Why it exists</h2>
    <p>
      Retyping transactions from a PDF is slow and error-prone, and uploading a financial statement
      to an unknown website is risky. This converter does the work in your own browser, so you get a
      usable spreadsheet in seconds and nobody else sees your data.
    </p>

    <h2>Who it's for</h2>
    <p>
      Freelancers, online sellers, small business owners, bookkeepers, and anyone in the Philippines
      who wants to understand where their GCash money goes.
    </p>

    <h2>How we keep it accurate</h2>
    <p>
      Every conversion is checked against the statement itself: totals are compared with the
      statement's own Total Debit and Total Credit, and every running balance is checked against the
      row before it. If something doesn't add up, the rows are pointed out instead of guessed. The
      figures are always kept exactly as GCash printed them.
    </p>

    <h2>Not affiliated with GCash</h2>
    <p>
      This is an independent tool. It is not affiliated with, endorsed by, or sponsored by GCash,
      G-Xchange, Inc., or Mynt. "GCash" is used only to describe which statements the tool supports.
    </p>

    <h2>Contact</h2>
    <p>
      Found a statement that doesn't convert correctly, or have an idea? Email{" "}
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Please don't attach your statement.
      Describe the problem instead.
    </p>
  </div>
  <ConverterCta />
</BaseLayout>
