---
import Converter from "../components/Converter.astro";
import { getPosts, postUrl } from "../data/blog.ts";
import { REQUESTABLE_BANKS } from "../data/banks.ts";
import { faq } from "../data/faq.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_EMAIL, SITE_NAME, SITE_TAGLINE } from "../site.ts";

// FAQ "learn more" links only point at posts that exist in this build.
const postIds = new Set((await getPosts()).map((p) => p.id));

const schema = [
  // Tells Google the site name to show in results ("WalletToExcel", not the bare domain).
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    alternateName: ["Wallet to Excel", "wallettoexcel.com"],
    url: Astro.site?.href,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: SITE_NAME,
    alternateName: SITE_TAGLINE,
    url: Astro.site?.href,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires a modern web browser with JavaScript.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "PHP" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  },
];

// Line icons (24px grid, stroked).
const icons = {
  statement: "M7 3h7l5 5v13H7zM14 3v5h5M10 12h6M10 15.5h6M10 19h4",
  accurate: "M4 19V5m0 14h16M8 15l3-3 3 2 5-6",
  free: "M3 7h18v10H3zM3 11h18M8 7v10m8-10v10",
};
---

<BaseLayout
  title="GCash Statement to Excel – Free & Private | WalletToExcel"
  description="Convert your GCash transaction history PDF to Excel or CSV in seconds. Free, and private: your statement is processed on your device and never uploaded."
  schema={schema}
  flush
>
  <div class="hero-wrap">
    <h1>
      GCash statement to Excel, <span class="soft">in seconds.</span>
    </h1>
    <p class="lead">
      Turn your GCash transaction history PDF into a clean, checked spreadsheet for Excel, Google
      Sheets or CSV. Free to use, no sign-up.
    </p>
  </div>

  <Converter />

  <div class="features">
    {[
      {
        id: "f-statement",
        icon: icons.statement,
        title: "Built for GCash statements",
        text: "Reads the Transaction History layout as printed, including wrapped descriptions, reference numbers and running balances.",
      },
      {
        id: "f-accurate",
        icon: icons.accurate,
        title: "Checked, not guessed",
        text: "Every row is reconciled against the statement's totals and running balance. Gaps are pointed out, never changed.",
      },
      {
        id: "f-free",
        icon: icons.free,
        title: "Ready for Excel and Sheets",
        text: "Real dates, peso amounts, filters and a monthly summary. Free to use, no sign-up.",
      },
    ].map((f) => (
      <section class="feature" aria-labelledby={f.id}>
        <span class="feature-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              d={f.icon}
            />
          </svg>
        </span>
        <h2 id={f.id}>{f.title}</h2>
        <p>{f.text}</p>
      </section>
    ))}
  </div>

  <section class="section faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Questions</h2>
    {faq.map((f) => (
      <details>
        <summary>
          <h3>{f.question}</h3>
        </summary>
        <p>
          {f.answer}
          {f.more && postIds.has(f.more.postSlug) && (
            <>
              {" "}
              <a href={postUrl(f.more.postSlug)}>{f.more.text} →</a>
            </>
          )}
        </p>
      </details>
    ))}
  </section>

  <section class="section cta-band" aria-labelledby="need-more">
    <div class="cta-band-text">
      <h2 id="need-more">Using another wallet or bank?</h2>
      <p>Tell us which one to add next.</p>
    </div>
    <div class="cta-band-vote">
      <ul class="bank-chips" aria-label="Request a bank or wallet">
        {REQUESTABLE_BANKS.map((bank) => (
          <li>
            <button type="button" class="bank-chip" data-bank={bank} aria-pressed="false">
              {bank}
            </button>
          </li>
        ))}
      </ul>
      <p class="bank-note" id="vote-status" role="status" aria-live="polite">
        One tap. We only count the bank's name.
      </p>
      <p class="bank-note bank-fallback" id="vote-fallback" hidden>
        Couldn't send that.
        <a id="vote-fallback-link" href={`mailto:${CONTACT_EMAIL}`}>
          Email us instead
        </a>
        .
      </p>
    </div>
  </section>
  <script>
    import "../scripts/vote.ts";
  </script>
</BaseLayout>
