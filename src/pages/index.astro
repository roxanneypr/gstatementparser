---
import Converter from "../components/Converter.astro";
import { faq } from "../data/faq.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_EMAIL, SITE_NAME, SITE_TAGLINE } from "../site.ts";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: SITE_NAME,
    alternateName: SITE_TAGLINE,
    url: Astro.site?.href,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires a modern web browser with JavaScript.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "PHP" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  },
];

// Line icons (24px grid, stroked).
const icons = {
  private: "M12 3 5 6v5c0 4.4 3 8.4 7 9.5 4-1.1 7-5.1 7-9.5V6l-7-3Zm-2.5 9 2 2 4-4",
  accurate: "M4 19V5m0 14h16M8 15l3-3 3 2 5-6",
  free: "M3 7h18v10H3zM3 11h18M8 7v10m8-10v10",
};
---

<BaseLayout
  title="GCash Statement to Excel – Free & Private | WalletToExcel"
  description="Convert your GCash transaction history PDF to Excel or CSV in seconds. Free, and private: your statement is processed on your device and never uploaded."
  schema={schema}
  flush
>
  <div class="hero-wrap">
    <p class="badge-pill">
      <span class="badge-dot" aria-hidden="true"></span>Private by design. Nothing leaves your
      device.
    </p>
    <h1>
      GCash statement to Excel, <span class="soft">in seconds.</span>
    </h1>
    <p class="lead">
      Turn your GCash Transaction History PDF into a clean, checked spreadsheet. Free, no sign-up,
      and processed entirely in your browser.
    </p>
  </div>

  <Converter />

  <div class="features">
    {[
      {
        id: "f-private",
        icon: icons.private,
        title: "Private by default",
        text: "Your PDF is read in your browser. It's never uploaded, and nothing is saved after you close the page.",
      },
      {
        id: "f-accurate",
        icon: icons.accurate,
        title: "Checked, not guessed",
        text: "Every row is reconciled against the statement's totals and running balance. Gaps are pointed out, never changed.",
      },
      {
        id: "f-free",
        icon: icons.free,
        title: "Ready for Excel and Sheets",
        text: "Real dates, peso amounts, filters and a monthly summary. Free, with no sign-up and no limits.",
      },
    ].map((f) => (
      <section class="feature" aria-labelledby={f.id}>
        <span class="feature-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              d={f.icon}
            />
          </svg>
        </span>
        <h2 id={f.id}>{f.title}</h2>
        <p>{f.text}</p>
      </section>
    ))}
  </div>

  <section class="section faq-layout" aria-labelledby="faq">
    <div class="section-head">
      <span class="eyebrow">FAQ</span>
      <h2 id="faq">Questions, answered</h2>
      <p>Everything you need to know about converting your GCash statement.</p>
    </div>
    <div class="faq">
      {faq.map((f) => (
        <details>
          <summary>
            <h3>{f.question}</h3>
          </summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section cta-band" aria-labelledby="need-more">
    <div>
      <h2 id="need-more">Using another wallet or bank?</h2>
      <p>Maya, BPI, BDO and more are on the roadmap. Tell us which statement you need next.</p>
    </div>
    <a class="btn-primary btn-light" href={`mailto:${CONTACT_EMAIL}?subject=Statement%20request`}>
      Request a bank
    </a>
  </section>
</BaseLayout>
