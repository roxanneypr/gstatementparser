---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME } from "../site.ts";
---

<BaseLayout
  title={`Page Not Found – ${SITE_NAME}`}
  description="This page doesn't exist. Go back to the GCash statement to Excel converter."
  noindex
>
  <div class="prose">
    <h1>Page not found</h1>
    <p>Sorry, we couldn't find that page. It may have moved, or the link may be wrong.</p>
    <ul>
      <li>
        <a href="/">Convert your GCash statement to Excel</a>
      </li>
    </ul>
  </div>
</BaseLayout>
