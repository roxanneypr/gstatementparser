---
import Seo, { type Props as SeoProps } from "../components/Seo.astro";
import { getPosts } from "../data/blog.ts";
import { walletPages } from "../data/walletPages.ts";
import { CONTACT_EMAIL, SITE_NAME, uiStrings, type Lang } from "../site.ts";
import "../styles/global.css";

export interface Props extends SeoProps {
  lang?: Lang;
  /** Home page: the hero handles its own top spacing, and the converter is the page. */
  flush?: boolean;
}

const { lang = "en", flush = false, ...seo } = Astro.props;
const t = uiStrings(lang);
// The Blog link appears only once a post exists in this build (drafts count in dev only).
const hasBlog = (await getPosts()).length > 0;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Google Search shows a favicon whose size is a multiple of 48px; give it a PNG too. -->
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skipToContent}
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="26" height="26" />
          <span>{SITE_NAME}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            <li>
              {/* An in-page anchor on the home page (no reload, so a finished conversion is kept). */}
              <a class="nav-cta" href={flush ? "#convert" : "/#convert"}>
                {t.nav.convert}
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class:list={["container", { "page-top": !flush }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="footer-brand" href="/">
          <img src="/favicon.svg" alt="" width="20" height="20" />
          {SITE_NAME}
        </a>
        <nav aria-label="Footer">
          <ul>
            <li>
              <a href="/about">{t.footer.about}</a>
            </li>
            {hasBlog && (
              <li>
                <a href="/blog">{t.footer.blog}</a>
              </li>
            )}
            <li>
              <a href="/privacy">{t.footer.privacy}</a>
            </li>
            <li>
              <a href={`mailto:${CONTACT_EMAIL}`}>{t.footer.contact}</a>
            </li>
          </ul>
        </nav>
        <p class="works-with">
          Works with: <a href="/">GCash</a>
          {walletPages.map((p) => (
            <>
              {" · "}
              <a href={`/${p.slug}`}>{p.wallet}</a>
            </>
          ))}
        </p>
        <p class="disclaimer">
          © {year} {SITE_NAME}. {t.footer.disclaimer}
        </p>
      </div>
    </footer>
  </body>
</html>
