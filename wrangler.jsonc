// Cloudflare Worker for wallettoexcel.com. The site (including the converter) is static assets;
// the only server code is worker/index.ts for /api/* (the anonymous bank vote). Statement data is
// never sent anywhere. Workers Builds runs `npm run build`, then `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "wallettoexcel",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* reaches the Worker code; every other request is served straight from assets.
    "run_worker_first": ["/api/*"],
    // Serve dist/404.html (with a 404 status) for unknown URLs.
    "not_found_handling": "404-page",
    // /about -> about.html, /blog -> blog.html (matches the build's "file" format).
    "html_handling": "auto-trailing-slash",
  },
  "durable_objects": {
    "bindings": [{ "name": "VOTES", "class_name": "VoteCounter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoteCounter"] }],
  // No request logs: we don't keep records of who visited or voted.
  "observability": { "enabled": false },
}
