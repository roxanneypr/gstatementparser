/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages: same caching as Cloudflare's default, plus "no-transform" so Cloudflare never
# modifies the pages (e.g. auto-injected analytics). Only our own code runs on the converter.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/about
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/privacy
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/blog
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/blog/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/maya-statement-to-excel
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/bpi-statement-to-excel
  Cache-Control: public, max-age=0, must-revalidate, no-transform
